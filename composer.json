    "keywords": [
        "exponential",
        "exponential-legacy",
        "ezpublish-legacy",
        "extension",
        "content class",
        "list",
        "admin",
        "bulk delete"
    ],
    "homepage": "https://github.com/se7enxweb/netgen-ezclasslists",
    "support": {
        "issues": "https://github.com/se7enxweb/netgen-ezclasslists/issues",
