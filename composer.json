    },
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "Damien Pobel",
            "homepage": "https://damien.pobel.fr",
            "role": "Author"
        },
        {
            "name": "Netgen",
            "homepage": "https://netgen.io",
            "role": "Developer"
        },
        {
            "name": "7x",
            "email": "info@se7enx.com",
            "homepage": "https://se7enx.com",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=8.0",
        "se7enxweb/exponential-legacy-installer": "*"
    },
    "replace": {
        "netgen/ezclasslists": "self.version"
